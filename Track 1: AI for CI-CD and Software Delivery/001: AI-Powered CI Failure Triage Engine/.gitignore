# ==============================================================================

# pytest
.pytest_cache/

# Generic test cache/output.
.testmondata
test-results/
test-output/

# Tox and Nox.
.tox/
.nox/

# Hypothesis.
.hypothesis/


# ==============================================================================
# COVERAGE
# ==============================================================================

.coverage
.coverage.*
coverage.xml
coverage.json
htmlcov/

*.cover
*.py,cover

# Coverage cache.
.coverage_cache/


# ==============================================================================
# APPLICATION RUNTIME LOGS
# ==============================================================================

*.log
*.log.*

logs/
runtime-logs/

# Rotated logs.
*.log.[0-9]*
*.log.gz


# ==============================================================================
# IMPORTANT — PROJECT SAMPLE LOGS
# ==============================================================================
#
# Project 001 intentionally stores synthetic .log files under sample-data/.
#
# The global *.log rule above would normally ignore them, so the rules below
# explicitly keep the project fixtures tracked.
#
# These files must contain synthetic training/testing data only.
# Never place real private CI logs in sample-data/.
#
# ==============================================================================

!sample-data/
!sample-data/**/*.log


# ==============================================================================
# EVALUATION OUTPUT
# ==============================================================================
#
# The evaluation source files remain tracked:
#
#   evaluations/evaluation-dataset.json
#   evaluations/expected-behavior.md
#   evaluations/accuracy-evaluation.md
#   evaluations/groundedness-evaluation.md
#   evaluations/safety-evaluation.md
#   evaluations/evaluation-runner.py
#
# Locally generated evaluation artifacts should not be committed unless they
# are deliberately sanitized and promoted into documented project examples.
#
# ==============================================================================

evaluation-results/
evaluations/results/
evaluations/output/
evaluations/.results/


# ==============================================================================
# PROJECT EVIDENCE — GENERATED CONTENT
# ==============================================================================
#
# The evidence/ directory itself is part of the project and must remain tracked.
#
# Its README, checklist, .gitkeep files, and intentionally provided sample
# outputs remain version controlled.
#
# Learner-generated screenshots, terminal captures, test results, and runtime
# logs are ignored by default because they may contain machine-specific or
# sensitive information.
#
# ==============================================================================

# Generated screenshots.
evidence/screenshots/*
!evidence/screenshots/.gitkeep

# Generated terminal captures.
evidence/terminal-output/*
!evidence/terminal-output/.gitkeep

# Generated test/evaluation results.
evidence/test-results/*
!evidence/test-results/.gitkeep

# Generated runtime log evidence.
evidence/logs/*
!evidence/logs/.gitkeep

# IMPORTANT:
#
# Do not ignore evidence/sample-output/.
#
# The following sanitized project examples are intentionally tracked:
#
#   evidence/sample-output/successful-triage.json
#   evidence/sample-output/fallback-triage.json
#   evidence/sample-output/rejected-output.json


