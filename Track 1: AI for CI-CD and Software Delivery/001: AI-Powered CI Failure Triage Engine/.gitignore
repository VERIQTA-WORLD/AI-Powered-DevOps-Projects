# ==============================================================================
# Project 001 — AI-Powered CI Failure Triage Engine
# .gitignore
# ==============================================================================
#
# This repository is public.
#
# Never commit:
# - real credentials
# - populated environment files
# - local virtual environments
# - Python caches
# - test caches
# - coverage artifacts
# - local IDE state
# - runtime logs
# - generated evaluation results
# - temporary files
# - local build artifacts
#
# Intentional project fixtures, synthetic sample data, schemas, prompts,
# source code, tests, and documented sample outputs should remain tracked.
#
# ==============================================================================


# ==============================================================================
# ENVIRONMENT VARIABLES AND SECRETS
# ==============================================================================

# Local environment files may contain credentials or machine-specific values.
.env
.env.*
*.env

# Keep the public example configuration tracked.
!.env.example

# Common local secret/config variants.
.env.local
.env.development.local
.env.test.local
.env.production.local

# Private key and certificate material must not be committed.
*.pem
*.key
*.p12
*.pfx
*.jks

# Common credential files.
credentials.json
service-account.json
secrets.json
secrets.yaml
secrets.yml


# ==============================================================================
# PYTHON BYTECODE AND CACHE
# ==============================================================================

__pycache__/
*.py[cod]
*$py.class

# Compiled extension modules.
*.so


# ==============================================================================
# PYTHON VIRTUAL ENVIRONMENTS
# ==============================================================================

.venv/
venv/
env/
ENV/
venv.bak/
env.bak/


# ==============================================================================
# PYTHON PACKAGING AND BUILD OUTPUT
# ==============================================================================

build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/

*.egg-info/
.installed.cfg
*.egg
MANIFEST


