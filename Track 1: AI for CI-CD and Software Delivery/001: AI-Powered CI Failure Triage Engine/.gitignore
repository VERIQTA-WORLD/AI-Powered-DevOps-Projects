# ==============================================================================
# KEEP PROJECT PLACEHOLDERS
# ==============================================================================
#
# .gitkeep files are intentionally used in empty evidence directories so the
# public repository preserves the expected structure.
#
# ==============================================================================

!.gitkeep
!**/.gitkeep


# ==============================================================================
# PROJECT 001 FILES THAT MUST REMAIN TRACKED
# ==============================================================================
#
# These explicit rules protect important public project files from broader
# ignore patterns above.
#
# ==============================================================================

!.env.example

!sample-data/
!sample-data/**

!evidence/
!evidence/README.md
!evidence/EVIDENCE-CHECKLIST.md
!evidence/sample-output/
!evidence/sample-output/**

!prompts/
!prompts/**

!schemas/
!schemas/**

!evaluations/
!evaluations/README.md
!evaluations/evaluation-dataset.json
!evaluations/expected-behavior.md
!evaluations/accuracy-evaluation.md
!evaluations/groundedness-evaluation.md
!evaluations/safety-evaluation.md
!evaluations/evaluation-runner.py


# ==============================================================================
# FINAL PUBLIC-REPOSITORY SAFETY REMINDER
# ==============================================================================
#
# .gitignore is a safety net, not a security control.
#
# Before every push, review:
#
#   git status
#   git diff --staged
#
# Confirm that you are not committing:
#
# - .env
# - API keys
# - access tokens
# - passwords
# - private keys
# - real CI/CD logs
# - private source code
# - internal infrastructure information
# - unsanitized screenshots
# - unsanitized terminal output
# - model responses containing sensitive context
#
# If a secret has already been committed, adding it to .gitignore does not
# remove it from Git history.
#
# Revoke or rotate the exposed credential and follow the appropriate
# repository history-remediation process.
#
# ==============================================================================
