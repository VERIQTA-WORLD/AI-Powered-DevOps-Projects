# PYTHON TOOLING
# ==============================================================================

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyright
.pyright/

# Ruff
.ruff_cache/

# Pyre
.pyre/

# Pytype
.pytype/

# Cython
cython_debug/


# ==============================================================================
