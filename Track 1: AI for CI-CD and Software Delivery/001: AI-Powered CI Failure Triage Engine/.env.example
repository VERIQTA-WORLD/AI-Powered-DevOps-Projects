# ==============================================================================
# Project 001 — AI-Powered CI Failure Triage Engine
# Example Environment Configuration
# ==============================================================================
#
# Copy this file to .env when you begin local configuration:
#
#   cp .env.example .env
#
# IMPORTANT:
#
# - Never place real credentials in .env.example.
# - Never commit your populated .env file.
# - Add real provider credentials only to your local .env file.
# - Not every variable is required during the early project milestones.
# - External AI integration is introduced later in the build.
#
# ==============================================================================


# ==============================================================================
# APPLICATION
# ==============================================================================

# Human-readable application name.
APP_NAME=AI-Powered-CI-Failure-Triage-Engine

# Runtime environment.
#
# Supported project values:
#   development
#   test
#   production
APP_ENV=development

# Enable additional development diagnostics.
#
# Keep disabled unless the project instructions explicitly require it.
# Debug output must never be relied on in production.
APP_DEBUG=false

# Host used by the local API service.
APP_HOST=0.0.0.0

# Port used by the local API service.
APP_PORT=8000


# ==============================================================================
# LOGGING
# ==============================================================================

# Application log level.
#
# Typical values:
#   DEBUG
#   INFO
#   WARNING
#   ERROR
#   CRITICAL
LOG_LEVEL=INFO

# Log output format.
#
# Supported project values:
#   text
#   json
LOG_FORMAT=text

# Apply supported sensitive-data redaction to application logging.
LOG_REDACTION_ENABLED=true


# ==============================================================================
# AI PROVIDER
# ==============================================================================

# AI provider used by the application.
#
# Replace this placeholder when you reach the AI integration milestone.
#
# Provider-specific implementation should remain isolated behind the
# project's AI client rather than being spread across the application.
AI_PROVIDER=your-provider

# Model identifier used by the selected provider.
AI_MODEL=your-model

# Provider API key.
#
# NEVER put a real key in this .env.example file.
#
# Add the real value only to your local .env file.
AI_API_KEY=replace-with-your-api-key

# Optional provider base URL.
#
# Leave empty when the provider client should use its normal endpoint.
AI_BASE_URL=

# Maximum time, in seconds, to wait for an AI request.
#
# A provider timeout must not cause the entire triage workflow to lose
# deterministic evidence that has already been extracted.
AI_TIMEOUT_SECONDS=15

# Maximum number of additional attempts after an eligible transient
# provider failure.
#
# Retries remain intentionally bounded to avoid uncontrolled latency,
# duplicate load, and unnecessary inference cost.
AI_MAX_RETRIES=1

# Sampling temperature used by the configured provider when supported.
#
# Project 001 favors predictable, evidence-grounded analysis rather than
# creative variation.
AI_TEMPERATURE=0.0


# ==============================================================================
# AI OUTPUT CONTROLS
# ==============================================================================

# Require structured AI output.
AI_STRUCTURED_OUTPUT_ENABLED=true

# Validate AI-generated output before treating it as usable triage data.
AI_OUTPUT_VALIDATION_ENABLED=true

# Apply application-level safety checks to AI-generated output.
AI_SAFETY_CHECKS_ENABLED=true

# Reject AI output that fails the required output contract.
REJECT_INVALID_AI_OUTPUT=true


# ==============================================================================
# AI PERMISSION BOUNDARIES
# ==============================================================================

# Project 001 is a triage system.
#
# The AI component must not directly perform remediation.
AI_AUTO_REMEDIATION_ENABLED=false

# The AI component must not execute shell commands.
AI_SHELL_EXECUTION_ENABLED=false

# The AI component must not make infrastructure changes.
AI_INFRASTRUCTURE_CHANGES_ENABLED=false

# Human review remains required for AI-generated recommendations.
HUMAN_REVIEW_REQUIRED=true

# Destructive operations are outside the scope of Project 001.
DESTRUCTIVE_ACTIONS_ENABLED=false


# ==============================================================================
# SECRET REDACTION
# ==============================================================================

# Enable sensitive-data redaction.
REDACTION_ENABLED=true

# Require redaction before data is prepared for external AI processing.
REDACT_BEFORE_AI=true

# Replacement value used for supported detected secrets.
REDACTION_PLACEHOLDER=[REDACTED]

# Fail safely when required redaction cannot be completed.
#
# When true, the application should not continue to external AI analysis
# if the required redaction stage fails.
REDACTION_FAIL_CLOSED=true


# ==============================================================================
# DETERMINISTIC EVIDENCE EXTRACTION
# ==============================================================================

# Enable deterministic evidence extraction before AI analysis.
EVIDENCE_EXTRACTION_ENABLED=true

# Maximum number of evidence items retained for a single analysis.
#
# The application must validate this configuration value.
EVIDENCE_MAX_ITEMS=50


# ==============================================================================
# AI CONTEXT CONTROL
# ==============================================================================

# Minimize context before external model submission.
#
# The model should receive only the information needed for the analysis
# rather than automatically receiving the complete CI log.
AI_CONTEXT_MINIMIZATION_ENABLED=true

# Application-level maximum size of model-bound context in characters.
#
# This is not a provider token limit.
AI_CONTEXT_MAX_CHARACTERS=20000

# Raw unredacted CI logs must not be sent directly to the external model.
SEND_RAW_LOGS_TO_AI=false


# ==============================================================================
# SCHEMAS
# ==============================================================================

# Input contract for the triage workflow.
TRIAGE_INPUT_SCHEMA_PATH=schemas/triage-input.schema.json

# Output contract for structured triage results.
TRIAGE_OUTPUT_SCHEMA_PATH=schemas/triage-output.schema.json


# ==============================================================================
# FALLBACK BEHAVIOR
# ==============================================================================

# Enable deterministic fallback behavior when AI analysis is unavailable.
AI_FALLBACK_ENABLED=true

# Preserve deterministic evidence in fallback reports.
FALLBACK_INCLUDE_EVIDENCE=true

# Clearly identify reports where AI analysis was unavailable.
FALLBACK_MARK_AI_UNAVAILABLE=true


# ==============================================================================
# PROMPTS
# ==============================================================================

# Version-controlled system instructions used by the AI layer.
AI_SYSTEM_PROMPT_PATH=prompts/system-prompt.md

# Version-controlled CI failure triage prompt.
AI_TRIAGE_PROMPT_PATH=prompts/triage-prompt.md

# Project rules governing prompt construction and AI interaction.
AI_PROMPT_RULES_PATH=prompts/prompt-rules.md


# ==============================================================================
# SAMPLE DATA
# ==============================================================================

# Root directory containing synthetic project data.
SAMPLE_DATA_DIR=sample-data

# Standard CI failure samples.
SAMPLE_FAILURE_DATA_DIR=sample-data/failures

# Synthetic samples containing values used to test redaction.
SAMPLE_SENSITIVE_DATA_DIR=sample-data/sensitive

# Malformed-input samples used for failure testing.
SAMPLE_MALFORMED_DATA_DIR=sample-data/malformed


# ==============================================================================
# API
# ==============================================================================

# Enable the local API interface.
API_ENABLED=true

# Maximum accepted API request body size in bytes.
#
# 1048576 bytes = 1 MiB.
#
# This value provides a configured limit only. The application/API layer
# must actually enforce it.
API_MAX_REQUEST_BYTES=1048576


# ==============================================================================
# OBSERVABILITY
# ==============================================================================

# Enable project metrics.
METRICS_ENABLED=true

# Measure relevant request and analysis latency.
METRICS_LATENCY_ENABLED=true

# Record fallback activation.
METRICS_FALLBACK_ENABLED=true

# Record output-validation failures.
METRICS_VALIDATION_FAILURES_ENABLED=true

# Record redaction events as safe counts or metadata.
#
# Metrics must never contain the original sensitive value.
METRICS_REDACTION_EVENTS_ENABLED=true


# ==============================================================================
# AI EVALUATION
# ==============================================================================

# Enable the project's AI evaluation workflow.
EVALUATION_ENABLED=true

# Evaluation dataset used by the project.
EVALUATION_DATASET_PATH=evaluations/evaluation-dataset.json

# Directory for locally generated evaluation results.
EVALUATION_RESULTS_DIR=evidence/test-results


# ==============================================================================
# TESTING
# ==============================================================================

# Runtime environment used during automated tests.
TEST_ENV=test

# Normal automated tests should not accidentally call a live external
# AI provider.
TEST_USE_LIVE_AI_PROVIDER=false

# Use deterministic/mock AI behavior for normal automated test execution.
TEST_USE_MOCK_AI=true


# ==============================================================================
# EVIDENCE
# ==============================================================================

# Root directory for learner-generated project evidence.
EVIDENCE_DIR=evidence

# Terminal output captured as project evidence.
EVIDENCE_TERMINAL_DIR=evidence/terminal-output

# Test and evaluation results.
EVIDENCE_TEST_RESULTS_DIR=evidence/test-results

# Project-generated log evidence.
EVIDENCE_LOGS_DIR=evidence/logs

# Example triage output.
EVIDENCE_SAMPLE_OUTPUT_DIR=evidence/sample-output


# ==============================================================================
# PROJECT 001 SECURITY INVARIANTS
# ==============================================================================
#
# These rules must remain true throughout the project.
#
# 1. Raw operational input is treated as untrusted.
#
# 2. Supported sensitive values are redacted before external AI processing.
#
# 3. Deterministic evidence remains distinguishable from AI interpretation.
#
# 4. Model output is treated as untrusted application input.
#
# 5. Structured model output is validated before use.
#
# 6. AI failure does not remove deterministic evidence already extracted.
#
# 7. AI does not execute shell commands.
#
# 8. AI does not modify infrastructure.
#
# 9. AI does not approve deployments.
#
# 10. AI does not perform production remediation.
#
# 11. Human review remains required for AI-generated recommendations.
#
# 12. Real secrets must never be committed to this public repository.
#
# ==============================================================================


# ==============================================================================
# LOCAL DEVELOPMENT REMINDER
# ==============================================================================
#
# Create your local configuration:
#
#   cp .env.example .env
#
# Edit:
#
#   .env
#
# Add provider credentials only when you reach the AI integration milestone.
#
# Before every commit, check:
#
#   git status
#
# The public repository should contain:
#
#   .env.example
#
# It must not contain your populated:
#
#   .env
#
# ==============================================================================
